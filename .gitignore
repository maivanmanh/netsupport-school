# Rust build output (root workspace and nested crates)
**/target/

# Flutter / Dart generated and downloaded files
**/.dart_tool/
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/.gradle/
**/doc/api/
**/android/local.properties
**/android/key.properties
**/*.jks
**/*.keystore
**/Flutter/ephemeral/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
.flutter-plugins
.flutter-plugins-dependencies

# Native platform build output and per-user IDE state
**/Pods/
**/DerivedData/
**/xcuserdata/
**/*.xcuserstate
**/.swiftpm/
**/.vs/
**/x64/
**/x86/
**/Win32/
*.suo
*.user
*.userosscache
*.sln.docstates
*.iml
*.ipr
*.iws
.idea/

# Compiled binaries, debug symbols, packages and crash dumps
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.obj
*.o
*.pdb
*.ilk
*.dSYM/
*.app/
*.msi
*.dmg
*.pkg
*.crash
*.dmp
core
core.*

# Runtime logs, temporary files and generated screenshots
*.log
*.log.*
*.stdout
*.stderr
*.tmp
*.temp
*.swp
*.ppm
*.py[cod]
__pycache__/

# Local app data and test evidence (retain locally; don't publish raw captures/logs)
**/logs/
**/outbox/
/checkpoints/evidence/

# Local secrets and machine-specific configuration; keep example templates
.env
.env.*
!.env.example
/config/*.local.toml
*.pem
*.p12
*.mobileprovision

# macOS / editor noise
.DS_Store
.AppleDouble
.LSOverride
._*
.vscode/*
!.vscode/extensions.json

# Private development updater transactions (plans/receipts contain session tokens)
**/.classroom-update-*/
